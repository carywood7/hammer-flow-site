          "_name": "form01",
          "_sourceTheme": "wonderm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form01 wonderm5\" group=\"Form\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\" plugins=\"formstyler, datepicker\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"color\" title=\"BG\" value=\"#ffffff\" name=\"cardBg\" selected>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#1d1d1d\" name=\"border\" condition=\"showBorder\" selected>\n        <header>Contacts</header>\n        <input type=\"checkbox\" title=\"Contacts\" name=\"showContacts\" checked>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" checked condition=\"showContacts\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" condition=\"showContacts\">\n        <input type=\"color\" title=\"Border Color\" value=\"#1d1d1d\" name=\"cardBorder\" condition=\"showContacts\" selected>\n        <header>Form</header>\n        <input type=\"color\" title=\"Input Color\" value=\"#1d1d1d\" name=\"inputColor\" selected>\n        <input type=\"color\" title=\"Border Color\" value=\"#1d1d1d\" name=\"formBorder\" selected>\n        <header>Background</header>\n        <input type=\"checkbox\" title=\"Decoration\" name=\"doubleBg\" checked>\n        <input type=\"color\" title=\"Color\" name=\"topbg\" value=\"#00a896\" condition=\"doubleBg\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/wonderm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/wonderm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    <input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\"></mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-11\">\n                <div class=\"content-wrapper card-wrap\">\n                    <div class=\"content-wrap\">\n                        <div class=\"title-wrapper\" mbr-if=\"showTitle || showText\">\n                            <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Claim Your 5 Free MSP Automation Blueprints.</b></h2>\n                            <div class=\"text-wrapper\">\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                                    Plug-and-play schematics you can implement in your MSP today—no long-term commitment required.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"items-wrapper\" mbr-if=\"showContacts\">\n                            <div class=\"item features-without-image\">\n                                <div class=\"item-wrapper\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"cards-icon_1 mbr-iconfont mobi-mbri-success mobi-mbri\" style=\"color: rgb(10, 37, 64); fill: rgb(10, 37, 64);\" data-app-selector=\".cards-icon_1\"></span>\n                                    </div>\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .iconfont-wrapper\">Pax8 License Sync Blueprint – Detect unbilled seats before invoicing.</h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">Pax8 License Sync Blueprint – Detect unbilled seats before invoicing.</p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"item features-without-image\">\n                                <div class=\"item-wrapper\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"cards-icon_2 mbr-iconfont mobi-mbri-success mobi-mbri\" style=\"color: rgb(10, 37, 64); fill: rgb(10, 37, 64);\" data-app-selector=\".cards-icon_2\"></span>\n                                    </div>\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .iconfont-wrapper\">\n                                            Phone\n                                        </h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">\n                                            Zero-Touch Offboarding Sequence – Revoke access instantly across tools.\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"item features-without-image\">\n                                <div class=\"item-wrapper\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"cards-icon_3 mbr-iconfont mobi-mbri-success mobi-mbri\" style=\"color: rgb(10, 37, 64); fill: rgb(10, 37, 64);\" data-app-selector=\".cards-icon_3\"></span>\n                                    </div>\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .iconfont-wrapper\">\n                                            Email\n                                        </h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">\n                                            AI Tech Note Drafter – Summarize tech logs into client-ready emails.\n                                        </p>\n                                    </div>\n                                </div>\n                            </div><div class=\"item features-without-image\">\n                                <div class=\"item-wrapper\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"cards-icon_3 mbr-iconfont mobi-mbri-success mobi-mbri\" style=\"color: rgb(10, 37, 64); fill: rgb(10, 37, 64);\" data-app-selector=\".cards-icon_3\"></span>\n                                    </div>\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .iconfont-wrapper\">\n                                            Email\n                                        </h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">\n                                            Client Sentiment Alert – Flag frustrated tickets before clients churn.\n                                        </p>\n                                    </div>\n                                </div>\n                            </div><div class=\"item features-without-image\">\n                                <div class=\"item-wrapper\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"cards-icon_3 mbr-iconfont mobi-mbri-success mobi-mbri\" style=\"color: rgb(10, 37, 64); fill: rgb(10, 37, 64);\" data-app-selector=\".cards-icon_3\"></span>\n                                    </div>\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .iconfont-wrapper\">\n                                            Email\n                                        </h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">\n                                            QBR Data Harvester – Extract backup &amp; ticket stats automatically.\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div mbr-form class=\"mbr-form form-wrap card-wrap\">\n<!--Formbuilder Form-->\n<form action name=\"5 blueprints\" method=\"POST\" class=\"mbr-form form-with-styler\">\n<div class=\"row\">\n<div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">\n</div>\n<div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\"> Oops...! some problem! </div>\n</div>\n<div class=\"dragArea row\">\n<div class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n<div class=\"row\">\n<div class=\"col\">\n<input type=\"text\" name=\"nameFirst\" placeholder=\"First Name\" data-form-field=\"nameFirst\" class=\"form-control text-multiple\" value>\n</div>\n<div class=\"col\">\n<input type=\"text\" name=\"nameLast\" placeholder=\"Last Name\" data-form-field=\"nameLast\" class=\"form-control text-multiple\" value>\n</div>\n</div>\n</div>\n<div class=\"col-lg-12 col-md-12 col-sm-12 form-group\" data-for=\"Company Name\">\n<input type=\"text\" name=\"Company Name\" placeholder=\"Company Name\" data-form-field=\"Company Name\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control\" value>\n</div>\n<div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"email1\">\n<input type=\"email\" name=\"email1\" placeholder=\"Business email\" data-form-field=\"email1\" mbr-theme-style=\"display-4\" required=\"required\" class=\"form-control\" value>\n</div>\n<div class=\"col-lg-12 col-md-12 col-sm-12\">\n<p mbr-theme-style=\"display-7\" class=\"mbr-fonts-style\">Use Business email</p>\n</div>\n<div mbr-buttons=\"true\" mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" class=\"col-md-auto col mbr-section-btn\">\n<a data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" type=\"submit\" class=\"w-100 w-100 w-100 btn btn-info-outline\"> Send Me The Blueprints </a>\n</div>\n</div>\n</form><!--Formbuilder Form-->\n</div>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div class=\"topbg\" mbr-if=\"doubleBg\"></div>\n</section>",
          "_cid": "vqgTjhbVDV",
          "_anchor": "form01-8",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            ".mbr-description": {
              "text-align": "left"
            },
            ".item-wrapper": {
              "background": "@cardbg",
              "margin-bottom": "2rem",
              "padding": "2.25rem",
              "@media (max-width: 767px)": {
                "padding": "2rem 1.5rem",
                "margin-bottom": "1rem"
              },
              "@media (min-width: 992px) and (max-width: 1200px)": {
                "padding": "2rem 1.5rem",
                "margin-bottom": "2rem"
              }
            },
            ".card-title, .iconfont-wrapper": {
              "color": "#000000"
            },
            ".card-text": {
              "color": "#000000"
            },
            ".mbr-section-title": {
              "color": "#000000",
              "text-align": "center"
            },
            ".mbr-number": {
              "color": "#9fe870"
            },
            ".mbr-text, .mbr-section-btn": {
              "text-align": "center"
            },
            ".card-text, .item .mbr-section-btn": {
              "text-align": "left"
            }
          },
          "_name": "features027",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features027\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,'mbr-parallax-background': bg.parallax}\">\n\t<mbr-parameters>\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n\t\t<input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n\t\t<input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n\t\t<input type=\"range\" name=\"imageWidth\" title=\"Image\" min=\"4\" max=\"8\" step=\"1\" value=\"6\">\n\t\t<header>Card</header>\n\t\t<input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\">\n\t\t<input type=\"checkbox\" title=\"Card Subtitle\" name=\"showCardSubtitle\" checked>\n\t\t<input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\">\n\t\t<input type=\"color\" title=\"Card BG\" name=\"cardbg\" value=\"#ffffff\" selected>\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#edefeb\" selected>\n\t\t\t<input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n\t\t</fieldset>\n\t\t<header condition=\"bg.type === 'video'\">Fallback Image</header>\n\t\t<input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n\t</mbr-parameters>\n\n\t<div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\n\t<div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\t\t<div class=\"row justify-content-center\" mbr-if=\"showTitle || showText\">\n\t\t\t<div class=\"col-md-12 content-head mb-5\">\n\t\t\t\t<h1 class=\"mbr-section-title mbr-fonts-style  mb-0\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>The Pre-Engineered Automation Catalog</b></h1>\n\t\t\t\t<p class=\"mbr-text mbr-fonts-style mt-4 mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">350+ plug-and-play workflows built across 25+ essential business categories.\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t</div>\n\n\n\t\t<div class=\"row justify-content-center  blockContent\">\n\t\t\t<div class=\"col-12 col-lg\">\n\t\t\t\t<div class=\"item features-without-image col-12 col-md-12 col-lg-12 active\">\n\t\t\t\t\t<div class=\"item-wrapper\">\n\t\t\t\t\t\t<div class=\"item-content\">\n\t\t\t\t\t\t\t<h5 class=\"mbr-card-title mbr-fonts-style mt-0 mb-3 mbr-number\" mbr-if=\"showCardTitle\" data-app-selector=\".mbr-number\" mbr-theme-style=\"display-1\">\n\t\t\t\t\t\t\t\t<b>01.</b>\n\t\t\t\t\t\t\t</h5>\n\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardSubtitle\" data-app-selector=\".card-title\"><b>AI, Analytics &amp; Intelligence</b></h4>\n\t\t\t\t\t\t\t<p class=\"card-text mbr-fonts-style mt-0 mb-0\" data-app-selector=\".card-text, .item .mbr-section-btn\" mbr-theme-style=\"display-7\">\n\t\t\t\t\t\t\t\tSmart data management, ticket sentiment scanning, and automated cross-platform dashboard reporting.\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<div class=\"mbr-section-btn item-footer mt-3\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\">\n\t\t\t\t\t\t\t\t<a href class=\"btn item-btn btn-primary\" data-app-placeholder=\"Type Text\">Learn More</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"item features-without-image col-12 col-md-12 col-lg-12\">\n\t\t\t\t\t<div class=\"item-wrapper\">\n\t\t\t\t\t\t<div class=\"item-content\">\n\t\t\t\t\t\t\t<h5 class=\"mbr-card-title mbr-fonts-style mt-0 mb-3 mbr-number\" mbr-if=\"showCardTitle\" data-app-selector=\".mbr-number\" mbr-theme-style=\"display-1\">\n\t\t\t\t\t\t\t\t<b>02.</b>\n\t\t\t\t\t\t\t</h5>\n\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardSubtitle\" data-app-selector=\".card-title\"><b>Service, Tech &amp; Productivity</b></h4>\n\t\t\t\t\t\t\t<p class=\"card-text mbr-fonts-style mt-0 mb-0\" data-app-selector=\".card-text, .item .mbr-section-btn\" mbr-theme-style=\"display-7\">\n\t\t\t\t\t\t\t\tAutomated ticket triage, engineer dispatching, instant messaging webhooks, email processing, and zero-touch calendar scheduling.\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<div class=\"mbr-section-btn item-footer mt-3\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\">\n\t\t\t\t\t\t\t\t<a href class=\"btn item-btn btn-primary\" data-app-placeholder=\"Type Text\">Learn More</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"item features-without-image col-12 col-md-12 col-lg-12\">\n\t\t\t\t\t<div class=\"item-wrapper\">\n\t\t\t\t\t\t<div class=\"item-content\">\n\t\t\t\t\t\t\t<h5 class=\"mbr-card-title mbr-fonts-style mt-0 mb-3 mbr-number\" mbr-if=\"showCardTitle\" data-app-selector=\".mbr-number\" mbr-theme-style=\"display-1\">\n\t\t\t\t\t\t\t\t<b>03.</b>\n\t\t\t\t\t\t\t</h5>\n\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardSubtitle\" data-app-selector=\".card-title\"><b>Finance, HR &amp; Operations</b></h4>\n\t\t\t\t\t\t\t<p class=\"card-text mbr-fonts-style mt-0 mb-0\" data-app-selector=\".card-text, .item .mbr-section-btn\" mbr-theme-style=\"display-7\">\n\t\t\t\t\t\t\t\tAutomated vendor bill matching, agreement synchronization, AI candidate certification screening, and hardware asset tracking.\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<div class=\"mbr-section-btn item-footer mt-3\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\">\n\t\t\t\t\t\t\t\t<a href class=\"btn item-btn btn-primary\" data-app-placeholder=\"Type Text\">Learn More</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div><div class=\"item features-without-image col-12 col-md-12 col-lg-12\">\n\t\t\t\t\t<div class=\"item-wrapper\">\n\t\t\t\t\t\t<div class=\"item-content\">\n\t\t\t\t\t\t\t<h5 class=\"mbr-card-title mbr-fonts-style mt-0 mb-3 mbr-number\" mbr-if=\"showCardTitle\" data-app-selector=\".mbr-number\" mbr-theme-style=\"display-1\">\n\t\t\t\t\t\t\t\t<b>03.</b>\n\t\t\t\t\t\t\t</h5>\n\t\t\t\t\t\t\t<h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardSubtitle\" data-app-selector=\".card-title\"><b>Sales, Marketing &amp; Growth</b></h4>\n\t\t\t\t\t\t\t<p class=\"card-text mbr-fonts-style mt-0 mb-0\" data-app-selector=\".card-text, .item .mbr-section-btn\" mbr-theme-style=\"display-7\">\n\t\t\t\t\t\t\t\tLead enrichment, automated quoting pipelines, SEO and social content workflows, email marketing, and review harvesting.\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<div class=\"mbr-section-btn item-footer mt-3\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\">\n\t\t\t\t\t\t\t\t<a href class=\"btn item-btn btn-primary\" data-app-placeholder=\"Type Text\">Learn More</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"col-12 col-lg-{{imageWidth}}\">\n\t\t\t\t<div class=\"image-wrapper\">\n\t\t\t\t\t<img class=\"w-100\" src=\"@PROJECT_PATH@/assets/images/collab-bro.png\" alt=\"Mobirise Website Builder\">\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t</div>\n\t</div>\n</section>",
          "_cid": "vqiJoyGj2P",
          "_anchor": "features027-h",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@showBorder)": {
              "border-top": "1px solid @border",
              "margin-top": "-1px"
            },
            ".topbg": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "100%",
              "height": "45%",
              "background": "@topbg",
              "& when (@showBorder)": {
                "border-bottom": "1px solid @border"
              }
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".content-wrapper": {
              "padding": "100px",
              "background-color": "@cardBg",
              "border": "1px solid @formBorder",
              "display": "grid",
              "grid-template-columns": "0.8fr 1fr",
              "gap": "120px",
              "position": "relative",
              "z-index": "1",
              "@media (max-width: 1640px)": {
                "padding": "80px"
              },
              "@media (max-width: 1440px)": {
                "padding": "60px",
                "gap": "60px"
              },
              "@media (max-width: 992px)": {
                "padding": "30px",
                "display": "block"
              },
              ".content-wrap": {
                ".title-wrapper": {
                  "margin-bottom": "45px",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "30px"
                  },
                  ".mbr-section-title": {
                    "margin-bottom": "15px"
                  },
                  ".mbr-text": {
                    "margin-bottom": "0"
                  }
                },
                ".items-wrapper": {
                  "@media (max-width: 992px)": {
                    "margin-bottom": "40px"
                  },
                  ".item": {
                    "margin-bottom": "25px",
                    "&:last-child": {
                      "margin-bottom": "0"
                    },
                    "@media (max-width: 992px)": {
                      "margin-bottom": "30px",
                      "&:last-child": {
                        "margin-bottom": "0"
                      }
                    },
                    ".item-wrapper": {
                      "display": "flex",
                      "align-items": "center",
                      "gap": "25px",
                      "@media (max-width: 992px)": {
                        "display": "block"
                      },
                      ".iconfont-wrapper": {
                        "@media (max-width: 992px)": {
                          "margin-bottom": "10px"
                        },
                        ".mbr-iconfont": {
                          "width": "40px",
                          "min-width": "40px",
                          "font-size": "40px",
                          "display": "inline-flex",
                          "-webkit-text-stroke": "1px @cardBorder",
                          "text-stroke": "1px @cardBorder"
                        }
                      },
                      ".card-box": {
                        ".item-title": {
                          "margin-bottom": "5px"
                        },
                        ".item-text": {
                          "margin-bottom": "0"
                        }
                      }
                    }
                  }
                }
              },
              ".form-wrap": {
                ".dragArea.row": {
                  "margin": "0 -9.6px",
                  ".form-group": {
                    "margin-bottom": "0 !important",
                    ".form-control-label": {
                      "width": "100%",
                      "margin-bottom": "0"
                    },
                    ".form-control": {
                      "padding": "10px 0",
                      "background-color": "transparent",
                      "border": "none !important",
                      "border-bottom": "1px solid @formBorder !important",
                      "box-shadow": "none",
                      "margin-bottom": "40px",
                      "border-radius": "0 !important",
                      "min-height": "54px !important",
                      "@media (max-width: 992px)": {
                        "margin-bottom": "30px"
                      },
                      "&::placeholder": {
                        "color": "@inputColor"
                      },
                      "&:hover, &:focus": {
                        "border": "none !important",
                        "border-bottom": "1px solid @formBorder !important"
                      }
                    },
                    "textarea": {
                      "min-height": "140px"
                    },
                    ".form-check": {
                      "padding-left": "2.1em",
                      ".form-check-input": {
                        "background-color": "@formBorder",
                        "border-color": "@formBorder"
                      }
                    }
                  },
                  ".mbr-section-btn": {
                    "width": "100%",
                    ".btn": {
                      "margin-bottom": "0",
                      "margin-right": "0",
                      "margin-top": "0",
                      "min-height": "auto"
                    }
                  }
                }
              }
            },
            ".btn-wrapper": {
              "margin-top": "-2rem"
            },
            ".mbr-section-title": {
              "color": "#00a896"
            },
            ".mbr-text": {
              "color": "#1d1d1d"
            },
            ".item-title": {
              "color": "#1d1d1d"
            },
            ".item-text": {
              "color": "#1d1d1d"
            },
            "label": {
              "color": "#888888"
            }
          },
          "_name": "form01",
          "_sourceTheme": "wonderm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form01 wonderm5\" group=\"Form\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\" plugins=\"formstyler, datepicker\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked=\"\">\n        <input type=\"color\" title=\"BG\" value=\"#ffffff\" name=\"cardBg\" selected=\"\">\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked=\"\">\n        <input type=\"color\" title=\"Border Color\" value=\"#1d1d1d\" name=\"border\" condition=\"showBorder\" selected=\"\">\n        <header>Contacts</header>\n        <input type=\"checkbox\" title=\"Contacts\" name=\"showContacts\" checked=\"\">\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" condition=\"showContacts\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" condition=\"showContacts\">\n        <input type=\"color\" title=\"Border Color\" value=\"#1d1d1d\" name=\"cardBorder\" condition=\"showContacts\" selected=\"\">\n        <header>Form</header>\n        <input type=\"color\" title=\"Input Color\" value=\"#1d1d1d\" name=\"inputColor\" selected=\"\">\n        <input type=\"color\" title=\"Border Color\" value=\"#1d1d1d\" name=\"formBorder\" selected=\"\">\n        <header>Background</header>\n        <input type=\"checkbox\" title=\"Decoration\" name=\"doubleBg\" checked=\"\">\n        <input type=\"color\" title=\"Color\" name=\"topbg\" value=\"#00a896\" condition=\"doubleBg\">\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected=\"\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    <input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\"></mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-11\">\n                <div class=\"content-wrapper card-wrap\">\n                    <div class=\"content-wrap\">\n                        <div class=\"title-wrapper\" mbr-if=\"showTitle || showText\">\n                            <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Download The Master MSP Automation Catalog</b></h2>\n                            <div class=\"text-wrapper\">\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">Get instant access to 15 core production-ready workflows + 25 extended departmental automation blueprints for your MSP.</p>\n                            </div>\n                        </div>\n                        <div class=\"items-wrapper\" mbr-if=\"showContacts\">\n                            \n                            \n                            <div class=\"item features-without-image active\">\n                                <div class=\"item-wrapper\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon=\"\" class=\"cards-icon_1 mbr-iconfont mobi-mbri-success mobi-mbri\" style=\"color: rgb(10, 37, 64); fill: rgb(10, 37, 64);\" data-app-selector=\".cards-icon_1\"></span>\n                                    </div>\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .iconfont-wrapper\">Pax8 License Sync Blueprint – Detect unbilled seats before invoicing.</h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">Use this form on a landing page to capture high-intent MSP leads in exchange for downloading the PDF/Doc catalog.</p>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div mbr-form=\"\" class=\"mbr-form form-wrap card-wrap\">\n<!--Formbuilder Form-->\n<form action=\"\" name=\"Catalog\" method=\"POST\" class=\"mbr-form form-with-styler\">\n<div class=\"row\">\n<div hidden=\"hidden\" data-form-alert=\"\" class=\"alert alert-success col-12\">\n</div>\n<div hidden=\"hidden\" data-form-alert-danger=\"\" class=\"alert alert-danger col-12\"> Oops...! some problem! </div>\n</div>\n<div class=\"dragArea row\">\n<div class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n<div class=\"row\">\n<div class=\"col\">\n<input type=\"text\" name=\"nameFirst\" placeholder=\"First Name\" data-form-field=\"nameFirst\" class=\"form-control text-multiple\" value=\"\">\n</div>\n<div class=\"col\">\n<input type=\"text\" name=\"nameLast\" placeholder=\"Last Name\" data-form-field=\"nameLast\" class=\"form-control text-multiple\" value=\"\">\n</div>\n</div>\n</div>\n<div class=\"col-lg-12 col-md-12 col-sm-12 form-group\" data-for=\"Company Name\">\n<input type=\"text\" name=\"Company Name\" placeholder=\"Company Name\" data-form-field=\"Company Name\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control\" value=\"\">\n</div>\n<div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"email1\">\n<input type=\"email\" name=\"email1\" placeholder=\"Business email\" data-form-field=\"email1\" mbr-theme-style=\"display-4\" required=\"required\" class=\"form-control\" value=\"\">\n</div>\n<div class=\"col-lg-12 col-md-12 col-sm-12\">\n<p mbr-theme-style=\"display-7\" class=\"mbr-fonts-style\">Use Business email</p>\n</div>\n<div mbr-buttons=\"true\" mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" class=\"col-md-auto col mbr-section-btn\">\n<a data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" type=\"submit\" class=\"w-100 w-100 btn btn-info-outline\"> Send Me The Catalog</a>\n</div>\n</div>\n</form><!--Formbuilder Form-->\n</div>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div class=\"topbg\" mbr-if=\"doubleBg\"></div>\n</section>",
          "_anchor": "form01-20",
          "_isUserblock": true,
          "_cid": "vrUlILI3Js",
