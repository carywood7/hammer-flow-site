                  }
                },
                ".mbr-list-title": {
                  "margin-bottom": "20px"
                },
                ".list": {
                  "padding": "0",
                  "margin": "0",
                  "list-style-type": "none",
                  ".item-wrap": {
                    "position": "relative",
                    "margin-bottom": "12px",
                    "transition": "all .3s ease",
                    "cursor": "pointer",
                    "&:last-child": {
                      "margin-bottom": "0"
                    },
                    "&:hover, &:focus": {
                      "color": "@active"
                    }
                  }
                }
              }
            },
            ".mbr-section-btn": {
              "margin-bottom": "20px",
              "& when not (@showBorder)": {
                "margin-bottom": "40px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "20px"
                }
              },
              ".btn": {
