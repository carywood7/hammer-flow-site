        "display1Size": "4.5",
        "display2Font": "Google Sans",
        "display2Size": "3",
        "display5Font": "Google Sans",
        "display5Size": "1.8",
        "display7Font": "Google Sans",
        "display7Size": "1",
        "display4Font": "Google Sans",
        "display4Size": "1",
        "isRoundedImages": true,
        "isRoundedButtons": true,
        "isLargeButtons": true,
        "isGhostButtonBorder": true,
        "underlinedLinks": false,
        "isAnimatedOnScroll": false,
        "isScrollToTopButton": false
      },
      "additionalSetColors": [
        "#00a896",
        "#0a2540"
      ]
