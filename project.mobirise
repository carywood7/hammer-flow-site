            },
            ".mbr-section-title, .mbr-section-btn, .content-wrapper": {
              "color": "#0a2540"
            },
            ".list, .item-wrap, .list-wrapper": {
              "color": "#0a2540"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "analyticm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 analyticm5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Image\" name=\"showImage\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Navigation List 1\" name=\"showList_1\" checked>\n        <input type=\"checkbox\" title=\"Navigation List 2\" name=\"showList_2\" checked>\n        <input type=\"checkbox\" title=\"List Title\" name=\"showListTitle\" condition=\"showList_1 || showList_2\">\n        <input type=\"color\" title=\"Active Color\" value=\"#0a2540\" name=\"active\" condition=\"showList_1 || showList_2\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <header>Border</header>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#BAC0CC\" name=\"border\" condition=\"showBorder\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/analyticm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/analyticm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f4f4f4\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-6\" mbr-if=\"showImage || showTitle\">\n                <div class=\"content-wrapper\">\n                    <div class=\"content-wrap\">\n                        <div class=\"image-wrapper\" mbr-if=\"showImage\">\n                            <img src=\"@PROJECT_PATH@/assets/images/hammerflowai-final.png\" alt=\"Mobirise Website Builder\">\n                        </div>\n                        <div class=\"title-wrapper\">\n                            <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn, .content-wrapper\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\">Enterprise-grade automations, custom AI workflows, and API integrations engineered exclusively for Managed Service Providers.</h2>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6 card\" mbr-if=\"showList_1 || showList_2 || showButtons\">\n                <div class=\"nav-wrapper\">\n                    <div class=\"nav-wrap\" mbr-if=\"showList_1\">\n                        <h3 class=\"mbr-list-title mbr-fonts-style\" data-app-selector=\".mbr-list-title\" mbr-theme-style=\"display-4\" mbr-if=\"showListTitle\">\n                            Clients\n                        </h3>\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"index.html#features04-2\" class=\"text-primary\"><u>Profit Leaks</u></a></li><a href=\"index.html#features04-2\" class=\"text-primary\"><u>\n                            </u></a><li class=\"item-wrap\"><a href=\"index.html#features022-6\" class=\"text-primary\"><u>Departmental</u> <u>Matrix</u></a></li>\n                            <li class=\"item-wrap\"><a href=\"index.html#form01-8\" class=\"text-primary\"><u>Catalog &amp; Blueprints</u></a></li><a href=\"index.html#form01-8\" class=\"text-primary\"><u>\n                            </u></a><li class=\"item-wrap\"><a href=\"index.html#features027-h\" class=\"text-primary\"><u>Partner Program</u></a></li><li class=\"item-wrap\"><a href=\"index.html#list01-a\" class=\"text-primary\"><u>FAQ</u></a></li>\n                        </ul>\n                    </div>\n                    <div class=\"nav-wrap\" mbr-if=\"showList_2\">\n                        <h3 class=\"mbr-list-title mbr-fonts-style\" data-app-selector=\".mbr-list-title\" mbr-theme-style=\"display-4\" mbr-if=\"showListTitle\">\n                            Services\n                        </h3>\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .list-wrapper\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"mailto:cary@hammerflowai.com\" class=\"text-primary\"><u>Support@HammerFlowAI.com</u></a></li><li class=\"item-wrap\"><b>Integrates with ConnectWise, Autotask, HaloPSA, NinjaOne, Pax8 &amp; open REST APIs.</b></li>\n                            <li class=\"item-wrap\"><br></li>\n                        </ul>\n                    </div>\n                </div>\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                    <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                        <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                        mobi@rise.com\n                    </a>\n                </div>\n            </div>\n            <div class=\"col-12\">\n                <div class=\"border-wrapper\" mbr-if=\"showBorder\"></div>\n                <p class=\"mbr-copy mbr-fonts-style\" data-app-selector=\".mbr-copy\" mbr-theme-style=\"display-7\" mbr-if=\"showCopy\">\n                    © Copyright 2026 HammerFlowAI- a Wednesday Technology LLP company - All Rights Reserved.&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; <a href=\"page1.html#article07-p\" class=\"text-primary\">Privacy Policy</a></p>\n            </div>\n        </div>\n    </div>\n</section>",
