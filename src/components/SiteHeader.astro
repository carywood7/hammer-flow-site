---
import BrandMark from "./BrandMark.astro";
import ButtonLink from "./ButtonLink.astro";
import { site } from "../data/site";
---

<header class="site-header" data-site-header data-menu-open="false">
  <div class="container site-header__inner">
    <BrandMark />

    <nav
      class="site-header__navigation"
      aria-label="Primary navigation"
    >
      {
        site.navigation.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
    </nav>

    <div class="site-header__action">
      <ButtonLink
        href="#audit"
        label="Request an Audit"
        variant="secondary"
      />
    </div>

    <button
      class="site-header__menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-navigation"
      aria-label="Open navigation menu"
      data-menu-toggle
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>

  <div
    class="site-header__mobile-panel"
    id="mobile-navigation"
    data-mobile-panel
    hidden
  >
    <div class="container">
      <nav
        class="site-header__mobile-navigation"
        aria-label="Mobile navigation"
      >
        {
          site.navigation.map((item, index) => (
            <a href={item.href}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{item.label}</strong>
              <i aria-hidden="true">→</i>
            </a>
          ))
        }

        <a class="site-header__mobile-audit" href="#audit">
          <span>06</span>
          <strong>Request an Audit</strong>
          <i aria-hidden="true">→</i>
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const toggle = header?.querySelector<HTMLButtonElement>(
    "[data-menu-toggle]",
  );
  const panel = header?.querySelector<HTMLElement>("[data-mobile-panel]");

  if (header && toggle && panel) {
    const mobileLinks = Array.from(
      panel.querySelectorAll<HTMLAnchorElement>("a"),
    );

    const setMenuOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute(
        "aria-label",
        open ? "Close navigation menu" : "Open navigation menu",
      );

      panel.hidden = !open;
      header.dataset.menuOpen = String(open);
      document.documentElement.classList.toggle("mobile-menu-open", open);
    };

    const menuIsOpen = () =>
      toggle.getAttribute("aria-expanded") === "true";

    toggle.addEventListener("click", () => {
      setMenuOpen(!menuIsOpen());
    });

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        setMenuOpen(false);
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !menuIsOpen()) {
        return;
      }

      setMenuOpen(false);
      toggle.focus();
    });

    document.addEventListener("click", (event) => {
      if (
        !menuIsOpen() ||
        !(event.target instanceof Node) ||
        header.contains(event.target)
      ) {
        return;
      }

      setMenuOpen(false);
    });

    const desktopBreakpoint = window.matchMedia(
      "(min-width: 68.0625rem)",
    );

    const handleBreakpointChange = (
      event: MediaQueryListEvent | MediaQueryList,
    ) => {
      if (event.matches) {
        setMenuOpen(false);
      }
    };

    desktopBreakpoint.addEventListener("change", handleBreakpointChange);
    handleBreakpointChange(desktopBreakpoint);
  }
</script>

<style>
  :global(html) {
    scroll-padding-top: 6.25rem;
  }

  :global(#main-content),
  :global(#services),
  :global(#workflows),
  :global(#approach),
  :global(#integrations),
  :global(#why-hammer-flow),
  :global(#audit) {
    scroll-margin-top: 6.25rem;
  }

  :global(html.mobile-menu-open) {
    overflow: hidden;
  }

  .site-header {
    position: sticky;
    z-index: 100;
    top: 0;
    width: 100%;
    border-bottom: var(--border-subtle);
    background: rgba(7, 10, 12, 0.92);
    box-shadow: 0 0.5rem 2rem rgba(0, 0, 0, 0.12);
    backdrop-filter: blur(18px);
    isolation: isolate;
  }

  .site-header__inner {
    display: grid;
    min-height: 5.25rem;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2rem;
  }

  .site-header__navigation {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 2.2vw, 2rem);
  }

  .site-header__navigation a {
    position: relative;
    color: var(--color-steel-300);
    font-size: 0.78rem;
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .site-header__navigation a::after {
    position: absolute;
    right: 0;
    bottom: -0.55rem;
    left: 0;
    height: 1px;
    background: var(--color-signal-300);
    content: "";
    opacity: 0;
    transform: scaleX(0.5);
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast);
  }

  .site-header__navigation a:hover,
  .site-header__navigation a:focus-visible {
    color: var(--color-paper-50);
  }

  .site-header__navigation a:hover::after,
  .site-header__navigation a:focus-visible::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .site-header__action :global(.button) {
    min-height: 2.7rem;
    padding-block: 0.65rem;
    font-size: 0.76rem;
  }

  .site-header__menu-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(216, 217, 212, 0.2);
    background: rgba(255, 255, 255, 0.025);
    color: var(--color-paper-50);
    cursor: pointer;
    place-content: center;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .site-header__menu-toggle:hover {
    border-color: rgba(240, 177, 76, 0.58);
    background: rgba(240, 177, 76, 0.06);
  }

  .site-header__menu-toggle:focus-visible {
    outline: 3px solid rgba(240, 177, 76, 0.28);
    outline-offset: 3px;
  }

  .site-header__menu-toggle span {
    display: block;
    width: 1.15rem;
    height: 1px;
    margin: 0.16rem auto;
    background: currentColor;
    transform-origin: center;
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast);
  }

  .site-header[data-menu-open="true"]
    .site-header__menu-toggle
    span:nth-child(1) {
    transform: translateY(0.32rem) rotate(45deg);
  }

  .site-header[data-menu-open="true"]
    .site-header__menu-toggle
    span:nth-child(2) {
    opacity: 0;
  }

  .site-header[data-menu-open="true"]
    .site-header__menu-toggle
    span:nth-child(3) {
    transform: translateY(-0.32rem) rotate(-45deg);
  }

  .site-header__mobile-panel {
    display: none;
  }

  .site-header__mobile-panel[hidden] {
    display: none;
  }

  @media (max-width: 68rem) {
    :global(html) {
      scroll-padding-top: 5.5rem;
    }

    :global(#main-content),
    :global(#services),
    :global(#workflows),
    :global(#approach),
    :global(#integrations),
    :global(#why-hammer-flow),
    :global(#audit) {
      scroll-margin-top: 5.5rem;
    }

    .site-header__inner {
      min-height: 4.75rem;
      grid-template-columns: 1fr auto;
      gap: 1rem;
    }

    .site-header__navigation,
    .site-header__action {
      display: none;
    }

    .site-header__menu-toggle {
      display: grid;
    }

    .site-header__mobile-panel:not([hidden]) {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: block;
      max-height: calc(100svh - 4.75rem);
      overflow-y: auto;
      border-bottom: 1px solid rgba(216, 217, 212, 0.18);
      background:
        linear-gradient(
          180deg,
          rgba(14, 20, 24, 0.99),
          rgba(7, 10, 12, 0.99)
        );
      box-shadow: 0 1.5rem 3rem rgba(0, 0, 0, 0.34);
    }

    .site-header__mobile-navigation {
      display: grid;
      padding-block: 0.7rem 1.2rem;
      border-top: 1px solid rgba(216, 217, 212, 0.08);
    }

    .site-header__mobile-navigation a {
      display: grid;
      min-height: 3.75rem;
      grid-template-columns: 2rem 1fr auto;
      align-items: center;
      gap: 0.75rem;
      border-bottom: 1px solid rgba(216, 217, 212, 0.1);
      color: var(--color-paper-100);
      transition:
        background-color var(--transition-fast),
        color var(--transition-fast);
    }

    .site-header__mobile-navigation a:hover,
    .site-header__mobile-navigation a:focus-visible {
      background: rgba(255, 255, 255, 0.035);
      color: var(--color-signal-300);
    }

    .site-header__mobile-navigation a:focus-visible {
      outline: 2px solid rgba(240, 177, 76, 0.42);
      outline-offset: -2px;
    }

    .site-header__mobile-navigation span {
      color: var(--color-signal-300);
      font-family: var(--font-mono);
      font-size: 0.58rem;
    }

    .site-header__mobile-navigation strong {
      font-size: 0.83rem;
      font-weight: 500;
    }

    .site-header__mobile-navigation i {
      color: var(--color-steel-400);
      font-size: 0.85rem;
      font-style: normal;
    }

    .site-header__mobile-audit {
      margin-top: 0.65rem;
      padding-inline: 0.85rem;
      border: 1px solid rgba(240, 177, 76, 0.5) !important;
      background: rgba(240, 177, 76, 0.07);
    }
  }

  @media (max-width: 36rem) {
    .site-header__inner {
      min-height: 4.5rem;
    }

    .site-header__menu-toggle {
      width: 2.6rem;
      height: 2.6rem;
    }

    .site-header__mobile-panel:not([hidden]) {
      max-height: calc(100svh - 4.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__navigation a::after,
    .site-header__menu-toggle span {
      transition: none;
    }
  }
</style>
