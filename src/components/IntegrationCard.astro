---
interface Props {
  label: string;
  title: string;
  copy: string;
  examples: readonly string[];
}

const { label, title, copy, examples } = Astro.props;
---

<article class="integration-card">
  <span class="integration-card__label">{label}</span>

  <h3>{title}</h3>
  <p>{copy}</p>

  <ul aria-label={`${label} examples`}>
    {examples.map((example) => <li>{example}</li>)}
  </ul>
</article>

<style>
  .integration-card {
    display: flex;
    min-height: 15.5rem;
    flex-direction: column;
    padding: clamp(1.3rem, 2.3vw, 1.7rem);
    border-top: 1px solid rgba(9, 13, 16, 0.14);
  }

  .integration-card:nth-child(3n + 1),
  .integration-card:nth-child(3n + 2) {
    border-right: 1px solid rgba(9, 13, 16, 0.14);
  }

  .integration-card__label {
    margin-bottom: var(--space-5);
    color: #9b5f17;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .integration-card h3 {
    max-width: 17ch;
    margin-bottom: 0.7rem;
    color: var(--color-ink-950);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.7vw, 1.48rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.13;
  }

  .integration-card p {
    margin-bottom: var(--space-5);
    color: #53616a;
    font-size: 0.87rem;
    line-height: 1.62;
  }

  .integration-card ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.38rem;
    margin: auto 0 0;
    padding: 0;
    list-style: none;
  }

  .integration-card li {
    padding: 0.32rem 0.46rem;
    border: 1px solid rgba(9, 13, 16, 0.13);
    border-radius: var(--radius-small);
    color: #59666d;
    font-family: var(--font-mono);
    font-size: 0.53rem;
    line-height: 1.3;
  }

  @media (max-width: 66rem) {
    .integration-card:nth-child(3n + 1),
    .integration-card:nth-child(3n + 2) {
      border-right: 0;
    }

    .integration-card:nth-child(odd) {
      border-right: 1px solid rgba(9, 13, 16, 0.14);
    }
  }

  @media (max-width: 48rem) {
    .integration-card {
      min-height: auto;
      border-right: 0 !important;
    }
  }
</style>
