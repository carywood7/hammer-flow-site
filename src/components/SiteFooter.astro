---
import BrandMark from "./BrandMark.astro";
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__primary">
    <div class="site-footer__brand">
      <BrandMark />

      <p>
        Workflow automation implementation and managed services for MSP
        operations.
      </p>
    </div>

    <nav aria-label="Footer navigation">
      {
        site.navigation.map((item) => (
          <a href={`/${item.href}`}>{item.label}</a>
        ))
      }

      <a href="/#audit">Request an Audit</a>
    </nav>
  </div>

  <div class="container site-footer__secondary">
    <p>© {year} Hammer Flow.</p>

    <p>
      Service-led · Tool-agnostic · Client-owned infrastructure
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border-subtle);
    background: #070a0c;
  }

  .site-footer__primary {
    display: grid;
    grid-template-columns: minmax(16rem, 0.8fr) minmax(20rem, 1.2fr);
    gap: clamp(3rem, 7vw, 7rem);
    padding-block: clamp(2.75rem, 5vw, 4.25rem);
  }

  .site-footer__brand {
    display: grid;
    gap: 1.15rem;
  }

  .site-footer__brand p {
    max-width: 25rem;
    margin: 0;
    color: var(--color-steel-400);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .site-footer nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-content: start;
    gap: 0;
    border-top: var(--border-subtle);
  }

  .site-footer nav a {
    padding: 0.85rem 0;
    border-bottom: var(--border-subtle);
    color: var(--color-steel-300);
    font-size: 0.75rem;
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .site-footer nav a:nth-child(odd) {
    padding-right: 1rem;
  }

  .site-footer nav a:nth-child(even) {
    padding-left: 1rem;
    border-left: var(--border-subtle);
  }

  .site-footer nav a:hover {
    color: var(--color-paper-50);
  }

  .site-footer__secondary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    border-top: var(--border-subtle);
  }

  .site-footer__secondary p {
    margin: 0;
    color: var(--color-steel-500);
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.06em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  @media (max-width: 48rem) {
    .site-footer__primary {
      grid-template-columns: 1fr;
    }

    .site-footer__secondary {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 34rem) {
    .site-footer nav {
      grid-template-columns: 1fr;
    }

    .site-footer nav a,
    .site-footer nav a:nth-child(odd),
    .site-footer nav a:nth-child(even) {
      padding-inline: 0;
      border-left: 0;
    }
  }
</style>
