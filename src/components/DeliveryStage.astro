---
interface Props {
  number: string;
  title: string;
  copy: string;
  outcome: string;
}

const { number, title, copy, outcome } = Astro.props;
---

<article class="delivery-stage">
  <header>
    <span>{number}</span>
    <i aria-hidden="true"></i>
  </header>

  <h3>{title}</h3>
  <p>{copy}</p>

  <footer>
    <small>Delivery result</small>
    <strong>{outcome}</strong>
  </footer>
</article>

<style>
  .delivery-stage {
    display: flex;
    min-height: 18rem;
    flex-direction: column;
    padding: clamp(1.3rem, 2.3vw, 1.7rem);
    border: var(--border-subtle);
    background:
      linear-gradient(
        145deg,
        rgba(116, 168, 200, 0.035),
        transparent 50%
      ),
      rgba(17, 24, 29, 0.52);
  }

  .delivery-stage header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-6);
  }

  .delivery-stage header span {
    color: var(--color-signal-300);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
  }

  .delivery-stage header i {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--color-success-400);
    box-shadow: 0 0 0 0.28rem rgba(128, 185, 154, 0.08);
  }

  .delivery-stage h3 {
    max-width: 14ch;
    margin-bottom: 0.8rem;
    color: var(--color-paper-50);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.7vw, 1.48rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .delivery-stage > p {
    margin-bottom: var(--space-5);
    color: var(--color-steel-300);
    font-size: 0.87rem;
    line-height: 1.62;
  }

  .delivery-stage footer {
    display: grid;
    gap: 0.32rem;
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: var(--border-subtle);
  }

  .delivery-stage footer small {
    color: var(--color-steel-500);
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .delivery-stage footer strong {
    color: var(--color-paper-200);
    font-size: 0.74rem;
    font-weight: 500;
  }
</style>
