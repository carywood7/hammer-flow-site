---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
  label: string;
}

const {
  href,
  variant = "primary",
  label,
} = Astro.props;
---

<a class:list={["button", `button--${variant}`]} href={href}>
  <span>{label}</span>

  <svg viewBox="0 0 16 16" aria-hidden="true">
    <path d="M3 8h9M8.5 3.5 13 8l-4.5 4.5"></path>
  </svg>
</a>

<style>
  .button {
    display: inline-flex;
    min-height: 3.2rem;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    padding: 0.8rem 1.05rem 0.8rem 1.2rem;
    border: 1px solid transparent;
    border-radius: var(--radius-small);
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1;
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast),
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .button svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: square;
    stroke-width: 1.5;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button--primary {
    background: var(--color-signal-400);
    color: var(--color-ink-950);
  }

  .button--primary:hover {
    background: var(--color-signal-300);
  }

  .button--secondary {
    border-color: rgba(216, 217, 212, 0.16);
    background: rgba(216, 217, 212, 0.035);
    color: var(--color-paper-100);
  }

  .button--secondary:hover {
    border-color: rgba(216, 217, 212, 0.32);
    background: rgba(216, 217, 212, 0.07);
  }
</style>
