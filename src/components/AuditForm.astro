<form
  class="audit-form"
  name="automation-audit"
  method="POST"
  action="/thank-you/"
  data-netlify="true"
  netlify-honeypot="bot-field"
>
  <input type="hidden" name="form-name" value="automation-audit" />

  <p class="audit-form__honeypot">
    <label>
      Do not complete this field:
      <input name="bot-field" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <div class="audit-form__grid">
    <label>
      <span>Your name</span>

      <input
        type="text"
        name="full-name"
        autocomplete="name"
        required
      />
    </label>

    <label>
      <span>Work email</span>

      <input
        type="email"
        name="work-email"
        autocomplete="email"
        inputmode="email"
        required
      />
    </label>

    <label>
      <span>MSP or company</span>

      <input
        type="text"
        name="company"
        autocomplete="organization"
        required
      />
    </label>

    <label>
      <span>Current systems</span>

      <input
        type="text"
        name="current-systems"
        placeholder="PSA, RMM, Microsoft 365, workflow tools"
      />
    </label>
  </div>

  <label class="audit-form__full">
    <span>Which workflow needs to work better?</span>

    <textarea
      name="workflow"
      rows="5"
      placeholder="Describe the repeated work, handoffs, delays, service risk, or manual process."
      required
    ></textarea>
  </label>

  <div class="audit-form__grid">
    <label>
      <span>Current priority</span>

      <select name="priority" required>
        <option value="" selected disabled>Select one</option>
        <option value="exploring">Exploring opportunities</option>
        <option value="planned">Planned initiative</option>
        <option value="active-problem">Active operational problem</option>
        <option value="urgent">Urgent service risk</option>
      </select>
    </label>

    <label>
      <span>Preferred first step</span>

      <select name="preferred-first-step" required>
        <option value="" selected disabled>Select one</option>
        <option value="workflow-audit">Workflow audit</option>
        <option value="discovery-conversation">Discovery conversation</option>
        <option value="implementation-review">Implementation review</option>
        <option value="managed-automation">Managed automation discussion</option>
      </select>
    </label>
  </div>

  <label class="audit-form__consent">
    <input type="checkbox" name="contact-consent" required />

    <span>
      I agree to be contacted about this Hammer Flow automation request.
    </span>
  </label>

  <div class="audit-form__submit">
    <button type="submit">
      Request an Automation Audit
      <span aria-hidden="true">→</span>
    </button>

    <p>
      Submitted information is used only to review and respond to this request.
    </p>
  </div>
</form>

