---
interface Props {
  index: number;
  title: string;
  copy: string;
}

const { index, title, copy } = Astro.props;
const number = String(index).padStart(2, "0");
---

<article class="problem-card">
  <span class="problem-card__number">{number}</span>

  <div>
    <h3>{title}</h3>
    <p>{copy}</p>
  </div>
</article>

<style>
  .problem-card {
    display: grid;
    min-height: 10.75rem;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    padding: clamp(1.25rem, 2.2vw, 1.6rem);
    border-top: 1px solid rgba(9, 13, 16, 0.14);
  }

  .problem-card:nth-child(odd) {
    border-right: 1px solid rgba(9, 13, 16, 0.14);
  }

  .problem-card__number {
    padding-top: 0.2rem;
    color: #9b5f17;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
  }

  .problem-card h3 {
    margin-bottom: 0.6rem;
    color: var(--color-ink-950);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.7vw, 1.48rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .problem-card p {
    max-width: 31rem;
    margin: 0;
    color: #53616a;
    font-size: 0.9rem;
    line-height: 1.62;
  }

  @media (max-width: 42rem) {
    .problem-card {
      min-height: auto;
      border-right: 0 !important;
    }
  }
</style>
