---
import BaseLayout from "../layouts/BaseLayout.astro";
import ButtonLink from "../components/ButtonLink.astro";
import ProblemCard from "../components/ProblemCard.astro";
import ServiceCard from "../components/ServiceCard.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SystemDiagram from "../components/SystemDiagram.astro";
import WorkflowRow from "../components/WorkflowRow.astro";
import { operationalProblems, services } from "../data/company";
import {
  referenceWorkflows,
  workflowControls,
} from "../data/workflows";

const proofPoints = [
  "5 validated reference workflows",
  "Deterministic business rules",
  "Read-only-first delivery",
  "Human-review safeguards",
  "Client-owned infrastructure",
];
---

<BaseLayout>
  <SiteHeader />

  <main>
    <section class="hero">
      <div class="container hero__grid">
        <div class="hero__content">
          <p class="eyebrow">MSP automation implementation</p>

          <h1>
            Automation engineered
            <em>around your MSP.</em>
          </h1>

          <p class="hero__summary">
            Hammer Flow audits, designs, integrates, and manages operational
            workflows across PSA, RMM, Microsoft 365, onboarding, and service
            operations—without forcing your team into another platform.
          </p>

          <p class="hero__positioning">
            Service-led. Tool-agnostic. Built for controlled rollout.
          </p>

          <div class="hero__actions">
            <ButtonLink
              href="#audit"
              label="Request an Audit"
            />

            <ButtonLink
              href="#workflows"
              label="View Workflow Examples"
              variant="secondary"
            />
          </div>

          <dl class="hero__principles">
            <div>
              <dt>01</dt>
              <dd>Service-led and tool-agnostic</dd>
            </div>

            <div>
              <dt>02</dt>
              <dd>Read-only before write access</dd>
            </div>

            <div>
              <dt>03</dt>
              <dd>Human control where it matters</dd>
            </div>
          </dl>
        </div>

        <div class="hero__visual">
          <SystemDiagram />
        </div>
      </div>
    </section>

    <section class="proof" aria-label="Hammer Flow delivery principles">
      <div class="container proof__grid">
        {
          proofPoints.map((point, index) => (
            <div class="proof__item">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{point}</strong>
            </div>
          ))
        }
      </div>
    </section>

    <section class="problems">
      <div class="container problems__shell">
        <div class="problems__intro">
          <div>
            <p class="eyebrow">Operational pressure</p>

            <h2>
              The work MSP teams repeat, chase, and discover too late.
            </h2>
          </div>

          <p>
            Hammer Flow starts with the operating problem—not a preferred
            platform. The aim is to remove avoidable manual effort while
            preserving control, accountability, and service context.
          </p>
        </div>

        <div class="problems__grid">
          {
            operationalProblems.map((problem, index) => (
              <ProblemCard
                index={index + 1}
                title={problem.title}
                copy={problem.copy}
              />
            ))
          }
        </div>
      </div>
    </section>

    <section id="services" class="services-section section">
      <div class="container">
        <div class="services-section__intro">
          <div>
            <p class="eyebrow">Automation services</p>

            <h2 class="section-title">
              From workflow audit to managed operation.
            </h2>
          </div>

          <p class="section-copy">
            Hammer Flow provides implementation expertise around the systems
            the MSP already uses. There is no requirement to replace the PSA,
            RMM, workflow engine, or Microsoft environment.
          </p>
        </div>

        <div class="services-section__grid">
          {
            services.map((service, index) => (
              <ServiceCard
                index={index + 1}
                title={service.title}
                copy={service.copy}
                outcome={service.outcome}
              />
            ))
          }
        </div>
      </div>
    </section>

    <section id="workflows" class="workflow-showcase section">
      <div class="container">
        <div class="workflow-showcase__intro">
          <div>
            <p class="eyebrow">Validated workflow examples</p>

            <h2 class="section-title">
              Five separate systems. One controlled delivery standard.
            </h2>
          </div>

          <div class="workflow-showcase__positioning">
            <p>
              These are public-safe local reference implementations—not
              packaged SaaS modules. Each demonstrates how Hammer Flow turns an
              MSP operating problem into deterministic logic, a reviewable
              output, and a safer production implementation plan.
            </p>

            <small>
              Current reference state: synthetic data, inactive sanitized
              exports, local delivery, and no production write access.
            </small>
          </div>
        </div>

        <div
          class="workflow-showcase__controls"
          aria-label="Reference workflow controls"
        >
          {
            workflowControls.map((control, index) => (
              <div>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{control}</strong>
              </div>
            ))
          }
        </div>

        <div class="workflow-showcase__list">
          {
            referenceWorkflows.map((workflow) => (
              <WorkflowRow
                id={workflow.id}
                category={workflow.category}
                title={workflow.title}
                purpose={workflow.purpose}
                logic={workflow.logic}
                proof={workflow.proof}
                outcome={workflow.outcome}
                control={workflow.control}
              />
            ))
          }
        </div>
      </div>
    </section>

    <section id="audit" class="audit-foundation">
      <div class="container audit-foundation__inner">
        <div>
          <p class="eyebrow">Audit-first delivery</p>

          <h2>Start with one workflow that needs to work better.</h2>
        </div>

        <p>
          The final audit section and contact path will be implemented after the
          complete page architecture and public contact details are confirmed.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3.25rem, 4.5vw, 4.75rem) clamp(2.75rem, 4vw, 3.75rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(28rem, 1.08fr);
    align-items: center;
    gap: clamp(3rem, 5.5vw, 6rem);
  }

  .hero__content {
    position: relative;
    z-index: 2;
  }

  .hero h1 {
    max-width: 11ch;
    margin-bottom: var(--space-5);
    color: var(--color-paper-50);
    font-family: var(--font-display);
    font-size: clamp(3rem, 4.7vw, 4.55rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.97;
  }

  .hero h1 em {
    display: block;
    color: var(--color-signal-300);
    font-style: normal;
  }

  .hero__summary {
    max-width: 38rem;
    margin-bottom: var(--space-4);
    color: var(--color-steel-300);
    font-size: clamp(1rem, 1.55vw, 1.12rem);
    line-height: 1.68;
  }

  .hero__positioning {
    margin-bottom: var(--space-5);
    color: var(--color-paper-200);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: var(--space-6);
  }

  .hero__principles {
    display: grid;
    max-width: 45rem;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 0;
    padding-top: var(--space-5);
    border-top: var(--border-subtle);
  }

  .hero__principles div {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.65rem;
    align-items: start;
  }

  .hero__principles dt {
    color: var(--color-signal-300);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .hero__principles dd {
    margin: 0;
    color: var(--color-steel-400);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .hero__visual {
    min-width: 0;
    max-width: 41rem;
    margin-left: auto;
  }

  .proof {
    border-block: var(--border-subtle);
    background: rgba(13, 18, 22, 0.78);
  }

  .proof__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .proof__item {
    display: grid;
    min-height: 7.25rem;
    align-content: center;
    gap: 0.45rem;
    padding: 1.2rem;
    border-right: var(--border-subtle);
  }

  .proof__item:first-child {
    border-left: var(--border-subtle);
  }

  .proof__item span {
    color: var(--color-signal-300);
    font-family: var(--font-mono);
    font-size: 0.6rem;
  }

  .proof__item strong {
    color: var(--color-paper-200);
    font-size: 0.76rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .problems {
    background: var(--color-paper-100);
    color: var(--color-ink-950);
  }

  .problems__shell {
    border-inline: 1px solid rgba(9, 13, 16, 0.14);
  }

  .problems__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(19rem, 0.7fr);
    align-items: end;
    gap: var(--space-7);
    padding: clamp(2.75rem, 4vw, 4rem) clamp(1.5rem, 4vw, 3rem);
  }

  .problems :global(.eyebrow) {
    color: #9b5f17;
  }

  .problems__intro h2 {
    max-width: 17ch;
    margin: 0;
    color: var(--color-ink-950);
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.25vw, 3.1rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.03;
  }

  .problems__intro > p {
    max-width: 32rem;
    margin: 0;
    color: #53616a;
    font-size: 0.96rem;
    line-height: 1.68;
  }

  .problems__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .services-section__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.7fr);
    align-items: end;
    gap: var(--space-8);
    margin-bottom: var(--space-6);
  }

  .services-section__intro .section-title,
  .services-section__intro .section-copy {
    margin-bottom: 0;
  }

  .services-section__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .workflow-showcase {
    border-top: var(--border-subtle);
    background:
      linear-gradient(
        180deg,
        rgba(116, 168, 200, 0.025),
        transparent 24rem
      );
  }

  .workflow-showcase__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(21rem, 0.72fr);
    align-items: end;
    gap: var(--space-8);
    margin-bottom: var(--space-7);
  }

  .workflow-showcase__intro .section-title {
    max-width: 17ch;
    margin-bottom: 0;
  }

  .workflow-showcase__positioning {
    display: grid;
    gap: 1rem;
  }

  .workflow-showcase__positioning p {
    margin: 0;
    color: var(--color-steel-300);
    font-size: 0.94rem;
    line-height: 1.68;
  }

  .workflow-showcase__positioning small {
    padding-top: 0.85rem;
    border-top: var(--border-subtle);
    color: var(--color-steel-500);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.055em;
    line-height: 1.55;
    text-transform: uppercase;
  }

  .workflow-showcase__controls {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-bottom: var(--space-6);
    border-block: var(--border-subtle);
  }

  .workflow-showcase__controls div {
    display: grid;
    min-height: 5.5rem;
    align-content: center;
    gap: 0.38rem;
    padding: 1rem;
    border-right: var(--border-subtle);
  }

  .workflow-showcase__controls div:first-child {
    border-left: var(--border-subtle);
  }

  .workflow-showcase__controls span {
    color: var(--color-signal-300);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .workflow-showcase__controls strong {
    color: var(--color-paper-200);
    font-size: 0.7rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .workflow-showcase__list {
    border-inline: var(--border-subtle);
  }

  .audit-foundation {
    padding-block: var(--space-9);
    border-top: var(--border-subtle);
    background: var(--color-paper-100);
    color: var(--color-ink-950);
  }

  .audit-foundation__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    align-items: end;
    gap: var(--space-8);
  }

  .audit-foundation :global(.eyebrow) {
    color: #9b5f17;
  }

  .audit-foundation h2 {
    max-width: 14ch;
    margin: 0;
    color: var(--color-ink-950);
    font-family: var(--font-display);
    font-size: clamp(2.15rem, 3.6vw, 3.45rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.03;
  }

  .audit-foundation p:last-child {
    max-width: 31rem;
    margin: 0;
    color: #4e5c64;
    line-height: 1.75;
  }

  @media (max-width: 66rem) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .problems__intro,
    .services-section__intro,
    .workflow-showcase__intro {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .workflow-showcase__controls {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .workflow-showcase__controls div:nth-child(n + 4) {
      border-top: var(--border-subtle);
    }

    .services-section__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hero__content {
      max-width: 52rem;
    }

    .hero__visual {
      max-width: 46rem;
      padding-top: 0;
    }

    .proof__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .proof__item:nth-child(3) {
      border-right: none;
    }

    .proof__item:nth-child(n + 4) {
      border-top: var(--border-subtle);
    }
  }

  @media (max-width: 48rem) {
    .hero {
      padding-top: 3.75rem;
    }

    .problems__grid,
    .services-section__grid,
    .workflow-showcase__controls {
      grid-template-columns: 1fr;
    }

    .workflow-showcase__controls div,
    .workflow-showcase__controls div:first-child {
      border-inline: var(--border-subtle);
    }

    .workflow-showcase__controls div + div {
      border-top: var(--border-subtle);
    }

    .problems__intro {
      padding-inline: 1.25rem;
    }

    .hero h1 {
      font-size: clamp(2.8rem, 12vw, 4.1rem);
    }

    .hero__principles {
      grid-template-columns: 1fr;
    }

    .proof__grid {
      grid-template-columns: 1fr;
    }

    .proof__item,
    .proof__item:first-child,
    .proof__item:nth-child(3) {
      border-right: var(--border-subtle);
      border-left: var(--border-subtle);
    }

    .proof__item + .proof__item {
      border-top: var(--border-subtle);
    }

    .audit-foundation__inner {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
