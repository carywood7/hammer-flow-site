---
import BaseLayout from "../layouts/BaseLayout.astro";
import AuditForm from "../components/AuditForm.astro";
import ButtonLink from "../components/ButtonLink.astro";
import DeliveryStage from "../components/DeliveryStage.astro";
import IntegrationCard from "../components/IntegrationCard.astro";
import ProblemCard from "../components/ProblemCard.astro";
import ServiceCard from "../components/ServiceCard.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SystemDiagram from "../components/SystemDiagram.astro";
import WorkflowRow from "../components/WorkflowRow.astro";
import { operationalProblems, services } from "../data/company";
import {
  referenceWorkflows,
  workflowControls,
  workflowGroups,
} from "../data/workflows";
import {
  deliveryStages,
  integrationCategories,
  reasonsToWorkTogether,
  safetyControls,
} from "../data/delivery";

const proofPoints = [
  "15 validated reference workflows",
  "Five MSP operating areas",
  "Deterministic business rules",
  "Read-only-first delivery",
  "Human-review safeguards",
];

const groupedWorkflows = workflowGroups.map((group) => ({
  ...group,
  workflows: referenceWorkflows.filter(
    (workflow) => workflow.group === group.id,
  ),
}));
---

<BaseLayout>
  <SiteHeader />

  <main id="main-content">
    <section class="hero">
      <div class="container hero__grid">
        <div class="hero__content">
          <p class="eyebrow">MSP automation implementation</p>

          <h1>
            Automation engineered
            <em>around your MSP.</em>
          </h1>

          <p class="hero__summary">
            Hammer Flow audits, designs, integrates, and manages operational
            workflows across service delivery, identity, security, governance,
            profitability, and endpoint protection—without forcing your team
            into another platform.
          </p>

          <p class="hero__positioning">
            Service-led. Tool-agnostic. Built for controlled rollout.
          </p>

          <div class="hero__actions">
            <ButtonLink
              href="#audit"
              label="Request an Audit"
            />

            <ButtonLink
              href="#workflows"
              label="View Workflow Examples"
              variant="secondary"
            />
          </div>

          <dl class="hero__principles">
            <div>
              <dt>01</dt>
              <dd>Service-led and tool-agnostic</dd>
            </div>

            <div>
              <dt>02</dt>
              <dd>Read-only before write access</dd>
            </div>

            <div>
              <dt>03</dt>
              <dd>Human control where it matters</dd>
            </div>
          </dl>
        </div>

        <div class="hero__visual">
          <SystemDiagram />
        </div>
      </div>
    </section>

    <section class="proof" aria-label="Hammer Flow delivery principles">
      <div class="container proof__grid">
        {
          proofPoints.map((point, index) => (
            <div class="proof__item">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{point}</strong>
            </div>
          ))
        }
      </div>
    </section>

    <section class="problems">
      <div class="container problems__shell">
        <div class="problems__intro">
          <div>
            <p class="eyebrow">Operational pressure</p>

            <h2>
              The work MSP teams repeat, chase, and discover too late.
            </h2>
          </div>

          <p>
            Hammer Flow starts with the operating problem—not a preferred
            platform. The aim is to remove avoidable manual effort while
            preserving control, accountability, and service context.
          </p>
        </div>

        <div class="problems__grid">
          {
            operationalProblems.map((problem, index) => (
              <ProblemCard
                index={index + 1}
                title={problem.title}
                copy={problem.copy}
              />
            ))
          }
        </div>
      </div>
    </section>

    <section id="services" class="services-section section">
      <div class="container">
        <div class="services-section__intro">
          <div>
            <p class="eyebrow">Automation services</p>

            <h2 class="section-title">
              From workflow audit to managed operation.
            </h2>
          </div>

          <p class="section-copy">
            Hammer Flow provides implementation expertise around the systems
            the MSP already uses. There is no requirement to replace the PSA,
            RMM, workflow engine, or Microsoft environment.
          </p>
        </div>

        <div class="services-section__grid">
          {
            services.map((service, index) => (
              <ServiceCard
                index={index + 1}
                title={service.title}
                copy={service.copy}
                outcome={service.outcome}
              />
            ))
          }
        </div>
      </div>
    </section>

    <section id="workflows" class="workflow-showcase section">
      <div class="container">
        <div class="workflow-showcase__intro">
          <div>
            <p class="eyebrow">Validated workflow examples</p>

            <h2 class="section-title">
              Fifteen workflows. Five operating areas. One controlled standard.
            </h2>
          </div>

          <div class="workflow-showcase__positioning">
            <p>
              These are public-safe local reference implementations—not
              packaged SaaS modules or active client deployments. Each shows how
              Hammer Flow turns an MSP operating problem into deterministic
              logic, a reviewable output, and a safer production implementation
              plan.
            </p>

            <small>
              Current reference state: synthetic data, inactive sanitized
              exports, repeatable validation, and no production write access.
            </small>

            <div class="workflow-showcase__links">
              <a
                href="https://carywood.co/hammer-flow.html#workflow-portfolio"
                target="_blank"
                rel="noopener noreferrer"
              >
                Review the complete portfolio
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </div>

        <div
          class="workflow-showcase__controls"
          aria-label="Reference workflow controls"
        >
          {
            workflowControls.map((control, index) => (
              <div>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{control}</strong>
              </div>
            ))
          }
        </div>

        <div class="workflow-showcase__groups">
          {
            groupedWorkflows.map((group, groupIndex) => (
              <section
                id={`workflow-group-${group.id}`}
                class="workflow-group"
              >
                <header class="workflow-group__header">
                  <span>{String(groupIndex + 1).padStart(2, "0")}</span>

                  <div>
                    <p>{group.range}</p>
                    <h3>{group.title}</h3>
                    <small>{group.description}</small>
                  </div>

                  <strong>
                    {group.workflows.length}
                    {group.workflows.length === 1 ? " workflow" : " workflows"}
                  </strong>
                </header>

                <div class="workflow-showcase__list">
                  {
                    group.workflows.map((workflow) => (
                      <WorkflowRow
                        id={workflow.id}
                        category={workflow.category}
                        title={workflow.title}
                        purpose={workflow.purpose}
                        logic={workflow.logic}
                        proof={workflow.proof}
                        outcome={workflow.outcome}
                        control={workflow.control}
                      />
                    ))
                  }
                </div>
              </section>
            ))
          }
        </div>
      </div>
    </section>

    <section class="margin-audit-section section">
      <div class="container margin-audit-section__grid">
        <div class="margin-audit-section__content">
          <p class="eyebrow">Related diagnostic tool</p>

          <h2 class="section-title">
            Quantify the operating leak before choosing what to automate.
          </h2>

          <p class="section-copy">
            MSP Margin Audit is a separate Rails diagnostic that estimates
            licensing leakage, technician administration, and manual dispatch
            cost. It creates a practical starting point for an automation
            conversation without pretending to replace a full financial audit.
          </p>

          <div class="margin-audit-section__actions">
            <a
              href="https://carywood.co/msp-margin-audit.html"
              target="_blank"
              rel="noopener noreferrer"
            >
              View MSP Margin Audit
              <span aria-hidden="true">↗</span>
            </a>

            <small>
              Functional MVP · public deployment pending
            </small>
          </div>
        </div>

        <div class="margin-audit-card" aria-label="MSP Margin Audit overview">
          <div class="margin-audit-card__header">
            <span>Planning scorecard</span>
            <strong>Three focused leakage areas</strong>
          </div>

          <dl>
            <div>
              <dt>01</dt>
              <dd>Unbilled cloud seats</dd>
            </div>

            <div>
              <dt>02</dt>
              <dd>Technician administration</dd>
            </div>

            <div>
              <dt>03</dt>
              <dd>Manual dispatch effort</dd>
            </div>
          </dl>

          <p>
            Outputs include estimated monthly and annual loss, reclaimed hours,
            potential value, ROI, payback, saved reports, and PDF scorecards.
          </p>
        </div>
      </div>
    </section>

    <section id="approach" class="approach-section section">
      <div class="container">
        <div class="approach-section__intro">
          <div>
            <p class="eyebrow">Delivery approach</p>

            <h2 class="section-title">
              A safer path from manual work to managed automation.
            </h2>
          </div>

          <p class="section-copy">
            Hammer Flow begins with the process and its operating risk. Tool
            selection, implementation, access, and production rollout follow
            only after the workflow is understood and review controls are clear.
          </p>
        </div>

        <div class="approach-section__stages">
          {
            deliveryStages.map((stage) => (
              <DeliveryStage
                number={stage.number}
                title={stage.title}
                copy={stage.copy}
                outcome={stage.outcome}
              />
            ))
          }
        </div>

        <div class="approach-section__controls">
          <div>
            <p class="eyebrow">Safety standard</p>

            <h3>Control is part of the implementation—not an afterthought.</h3>
          </div>

          <ul>
            {
              safetyControls.map((control, index) => (
                <li>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <strong>{control}</strong>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section id="integrations" class="integrations-section">
      <div class="container integrations-section__shell">
        <div class="integrations-section__intro">
          <div>
            <p class="eyebrow">Tools and integrations</p>

            <h2>
              Work with the systems your MSP already depends on.
            </h2>
          </div>

          <p>
            Hammer Flow is tool-agnostic. The implementation stack is selected
            around the workflow, API capabilities, permissions, maintainability,
            and the client's existing technical environment.
          </p>
        </div>

        <div class="integrations-section__grid">
          {
            integrationCategories.map((integration) => (
              <IntegrationCard
                label={integration.label}
                title={integration.title}
                copy={integration.copy}
                examples={integration.examples}
              />
            ))
          }
        </div>
      </div>
    </section>

    <section id="why-hammer-flow" class="why-section section">
      <div class="container why-section__grid">
        <div class="why-section__intro">
          <p class="eyebrow">Why Hammer Flow</p>

          <h2 class="section-title">
            Implementation expertise without another platform to manage.
          </h2>

          <p class="section-copy">
            Hammer Flow is designed for MSPs that want practical automation
            outcomes while keeping ownership of their systems, infrastructure,
            operating rules, and production access.
          </p>
        </div>

        <div class="why-section__reasons">
          {
            reasonsToWorkTogether.map((reason, index) => (
              <article>
                <span>{String(index + 1).padStart(2, "0")}</span>

                <div>
                  <h3>{reason.title}</h3>
                  <p>{reason.copy}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="audit" class="audit-section section">
      <div class="container audit-section__grid">
        <div class="audit-section__intro">
          <p class="eyebrow">Automation audit</p>

          <h2>Start with one workflow that needs to work better.</h2>

          <p>
            Describe the repeated work, service risk, handoffs, or disconnected
            systems. Hammer Flow will review the operating problem before
            recommending tools, access, or implementation.
          </p>

          <div class="audit-section__next">
            <p>What the first review covers</p>

            <ol>
              <li>
                <span>01</span>
                <strong>Operating problem and desired outcome</strong>
              </li>

              <li>
                <span>02</span>
                <strong>Current systems, owners, and handoffs</strong>
              </li>

              <li>
                <span>03</span>
                <strong>Risk, permissions, and review boundaries</strong>
              </li>
            </ol>
          </div>
        </div>

        <AuditForm />
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3.25rem, 4.5vw, 4.75rem) clamp(2.75rem, 4vw, 3.75rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(28rem, 1.08fr);
    align-items: center;
    gap: clamp(3rem, 5.5vw, 6rem);
  }

  .hero__content {
    position: relative;
    z-index: 2;
  }

  .hero h1 {
    max-width: 11ch;
    margin-bottom: var(--space-5);
    color: var(--color-paper-50);
    font-family: var(--font-display);
    font-size: clamp(3rem, 4.7vw, 4.55rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.97;
  }

  .hero h1 em {
    display: block;
    color: var(--color-signal-300);
    font-style: normal;
  }

  .hero__summary {
    max-width: 38rem;
    margin-bottom: var(--space-4);
    color: var(--color-steel-300);
    font-size: clamp(1rem, 1.55vw, 1.12rem);
    line-height: 1.68;
  }

  .hero__positioning {
    margin-bottom: var(--space-5);
    color: var(--color-paper-200);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: var(--space-6);
  }

  .hero__principles {
    display: grid;
    max-width: 45rem;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 0;
    padding-top: var(--space-5);
    border-top: var(--border-subtle);
  }

  .hero__principles div {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.65rem;
    align-items: start;
  }

  .hero__principles dt {
    color: var(--color-signal-300);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .hero__principles dd {
    margin: 0;
    color: var(--color-steel-400);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .hero__visual {
    min-width: 0;
    max-width: 41rem;
    margin-left: auto;
  }

  .proof {
    border-block: var(--border-subtle);
    background: rgba(13, 18, 22, 0.78);
  }

  .proof__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .proof__item {
    display: grid;
    min-height: 7.25rem;
    align-content: center;
    gap: 0.45rem;
    padding: 1.2rem;
    border-right: var(--border-subtle);
  }

  .proof__item:first-child {
    border-left: var(--border-subtle);
  }

  .proof__item span {
    color: var(--color-signal-300);
    font-family: var(--font-mono);
    font-size: 0.6rem;
  }

  .proof__item strong {
    color: var(--color-paper-200);
    font-size: 0.76rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .problems {
    background: var(--color-paper-100);
    color: var(--color-ink-950);
  }

  .problems__shell {
    border-inline: 1px solid rgba(9, 13, 16, 0.14);
  }

  .problems__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(19rem, 0.7fr);
    align-items: end;
    gap: var(--space-7);
    padding: clamp(2.75rem, 4vw, 4rem) clamp(1.5rem, 4vw, 3rem);
  }

  .problems :global(.eyebrow) {
    color: #9b5f17;
  }

  .problems__intro h2 {
    max-width: 17ch;
    margin: 0;
    color: var(--color-ink-950);
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.25vw, 3.1rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.03;
  }

  .problems__intro > p {
    max-width: 32rem;
    margin: 0;
    color: #53616a;
    font-size: 0.96rem;
    line-height: 1.68;
  }

  .problems__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .services-section__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.7fr);
    align-items: end;
    gap: var(--space-8);
    margin-bottom: var(--space-6);
  }

  .services-section__intro .section-title,
  .services-section__intro .section-copy {
    margin-bottom: 0;
  }

  .services-section__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .workflow-showcase {
    border-top: var(--border-subtle);
    background:
      linear-gradient(
        180deg,
        rgba(116, 168, 200, 0.025),
        transparent 24rem
      );
  }

  .workflow-showcase__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(21rem, 0.72fr);
    align-items: end;
    gap: var(--space-8);
    margin-bottom: var(--space-7);
  }

  .workflow-showcase__intro .section-title {
    max-width: 17ch;
    margin-bottom: 0;
  }

  .workflow-showcase__positioning {
    display: grid;
    gap: 1rem;
  }

  .workflow-showcase__positioning p {
    margin: 0;
    color: var(--color-steel-300);
    font-size: 0.94rem;
    line-height: 1.68;
  }

  .workflow-showcase__positioning small {
    padding-top: 0.85rem;
    border-top: var(--border-subtle);
    color: var(--color-steel-500);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.055em;
    line-height: 1.55;
    text-transform: uppercase;
  }

  .workflow-showcase__controls {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin-bottom: var(--space-6);
    border-block: var(--border-subtle);
  }

  .workflow-showcase__controls div {
    display: grid;
    min-height: 5.5rem;
    align-content: center;
    gap: 0.38rem;
    padding: 1rem;
    border-right: var(--border-subtle);
  }

  .workflow-showcase__controls div:first-child {
    border-left: var(--border-subtle);
  }

  .workflow-showcase__controls span {
    color: var(--color-signal-300);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .workflow-showcase__controls strong {
    color: var(--color-paper-200);
    font-size: 0.7rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .workflow-showcase__links {
    padding-top: 0.2rem;
  }

  .workflow-showcase__links a,
  .margin-audit-section__actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-signal-300);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .workflow-showcase__links a span,
  .margin-audit-section__actions a span {
    transition: transform 180ms ease;
  }

  .workflow-showcase__links a:hover span,
  .margin-audit-section__actions a:hover span {
    transform: translate(2px, -2px);
  }

  .workflow-showcase__groups {
    display: grid;
    gap: var(--space-7);
  }

  .workflow-group {
    scroll-margin-top: 2rem;
  }

  .workflow-group__header {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1.1rem;
    align-items: start;
    padding: 1.15rem 1.2rem;
    border: var(--border-subtle);
    border-bottom: 0;
    background: rgba(116, 168, 200, 0.035);
  }

  .workflow-group__header > span {
    display: grid;
    width: 2rem;
    height: 2rem;
    background: var(--color-signal-300);
    color: var(--color-ink-950);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    place-items: center;
  }

  .workflow-group__header p {
    margin: 0 0 0.35rem;
    color: var(--color-signal-300);
    font-family: var(--font-mono);
    font-size: 0.57rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .workflow-group__header h3 {
    margin: 0 0 0.45rem;
    color: var(--color-paper-50);
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .workflow-group__header small {
    display: block;
    max-width: 48rem;
    color: var(--color-steel-400);
    font-size: 0.72rem;
    line-height: 1.55;
  }

  .workflow-group__header > strong {
    padding-top: 0.45rem;
    color: var(--color-paper-300);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .workflow-showcase__list {
    border-inline: var(--border-subtle);
  }

  .margin-audit-section {
    border-top: var(--border-subtle);
    background: var(--color-paper-100);
    color: var(--color-ink-950);
  }

  .margin-audit-section__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.75fr);
    gap: clamp(3rem, 6vw, 6rem);
    align-items: center;
  }

  .margin-audit-section :global(.eyebrow) {
    color: #8a6240;
  }

  .margin-audit-section .section-title {
    max-width: 17ch;
    color: var(--color-ink-950);
  }

  .margin-audit-section .section-copy {
    max-width: 43rem;
    margin-bottom: var(--space-5);
    color: #53616a;
  }

  .margin-audit-section__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .margin-audit-section__actions a {
    color: #7d551d;
  }

  .margin-audit-section__actions small {
    color: #7a858b;
    font-family: var(--font-mono);
    font-size: 0.57rem;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .margin-audit-card {
    padding: clamp(1.4rem, 3vw, 2rem);
    background: #ffffff;
