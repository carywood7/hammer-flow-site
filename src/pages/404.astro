---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<BaseLayout
  title="Page not found | Hammer Flow"
  description="The requested Hammer Flow page could not be found."
  robots="noindex,nofollow"
>
  <SiteHeader />

  <main id="main-content" class="not-found-page">
    <div class="container not-found-page__inner">
      <p class="eyebrow">404 / Route not found</p>

      <h1>This workflow does not exist.</h1>

      <p class="not-found-page__copy">
        The requested page may have moved, or the address may be
        incorrect. Return to the Hammer Flow overview to continue.
      </p>

      <a class="not-found-page__link" href="/">
        Return to Hammer Flow
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .not-found-page {
    display: grid;
    min-height: calc(100svh - 5.25rem);
    align-items: center;
    background:
      radial-gradient(
        circle at 72% 28%,
        rgba(240, 177, 76, 0.08),
        transparent 32%
      ),
      var(--color-ink-950);
  }

  .not-found-page__inner {
    max-width: 58rem;
    padding-block: clamp(5rem, 10vw, 9rem);
  }

  .not-found-page h1 {
    max-width: 13ch;
    margin: 1.25rem 0 1.5rem;
    color: var(--color-paper-50);
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 7vw, 5.8rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.96;
  }

  .not-found-page__copy {
    max-width: 38rem;
    margin: 0 0 2rem;
    color: var(--color-steel-300);
    font-size: 1rem;
    line-height: 1.75;
  }

  .not-found-page__link {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    gap: 1rem;
    padding-inline: 1.1rem;
    border: 1px solid rgba(240, 177, 76, 0.48);
    color: var(--color-paper-50);
    font-size: 0.78rem;
    font-weight: 600;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .not-found-page__link:hover,
  .not-found-page__link:focus-visible {
    border-color: var(--color-signal-300);
    background: rgba(240, 177, 76, 0.08);
  }

  .not-found-page__link:focus-visible {
    outline: 3px solid rgba(240, 177, 76, 0.24);
    outline-offset: 3px;
  }

  @media (max-width: 42rem) {
    .not-found-page {
      min-height: calc(100svh - 4.5rem);
    }
  }
</style>
